# -*- mode: conf-space -*-

# Environment Specific Customizations
# command = /opt/homebrew/bin/fish
# working-directory = ~/Projects

# Useful commands
# ghostty +help
# ghostty +version
# ghostty +list-fonts
# ghostty +list-keybinds --docs --default
# ghostty +list-themes
# ghostty +list-colors
# ghostty +list-actions --docs
# ghostty +show-config
# ghostty +validate-config
# ghostty +show-face
# ghostty +crash-report

# Default settings
theme = dark:Arthur,light:Dawnfox
background-opacity = 1
# font-size = 13
unfocused-split-opacity = 0.7

# behavior settings
clipboard-paste-protection = false
copy-on-select = clipboard
quit-after-last-window-closed = true
scrollback-limit = 1073741824

# window look & feel
quick-terminal-position = top
quick-terminal-size = 60%,60%
split-divider-color = #ECC94B
window-decoration = auto
window-height = 40
window-new-tab-position = end
window-padding-balance = true
window-padding-color = background
window-padding-x = 2,4
window-padding-y = 2,4
window-save-state = always
window-theme = dark
window-width = 100

# cursor settings
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# compatibility with emacs
macos-option-as-alt = true
keybind = alt+right=unbind
keybind = alt+left=unbind

## Quick Terminal Prompt
keybind = global:cmd+g=toggle_quick_terminal

## Cycle to next split (like emacs other-window)
keybind = super+alt+o=goto_split:next

## Auto-split (splits along the larger dimension)
keybind = super+d=new_split:auto

## Resizing windows & splits
keybind = super+enter=toggle_split_zoom
keybind = super+shift+enter=toggle_fullscreen
keybind = super+shift+h=resize_split:left,10
keybind = super+shift+j=resize_split:down,10
keybind = super+shift+k=resize_split:up,10
keybind = super+shift+l=resize_split:right,10
keybind = super+shift+0=equalize_splits

## Switch to next split-pane
keybind = super+o:goto_split:next
keybind = super+shift+o:goto_split:previous

## Command Prompt
keybind = super+shift+;=toggle_command_palette

## Jump to next/previous prompt
keybind = super+alt+p=jump_to_prompt:-1
keybind = super+alt+n=jump_to_prompt:1 

## Save entire output to file
keybind = super+s>s>y=write_screen_file:copy
keybind = super+s>s>p=write_screen_file:paste
keybind = super+s>s>o=write_screen_file:open

## Saving only scrollback output to file
keybind = super+s>a>y=write_scrollback_file:copy
keybind = super+s>a>p=write_scrollback_file:paste
keybind = super+s>a>o=write_scrollback_file:open

## Save only selection to file
keybind = super+s>r>y=write_selection_file:copy
keybind = super+s>r>p=write_selection_file:paste
keybind = super+s>r>o=write_selection_file:open


