# -*- mode: conf-unix -*-

# Setup
# export GIT_CONFIG_GLOBAL=~/<path>/dotfiles/config/git/config

# Run on large repos that need to be maintained.
# git maintenance start

# To see which repos are registered with maintenance.
# git config --global --get-all maintenance.repo

[alias]
    cm = commit -m
    co = checkout
    d = diff
    dv = difftool -t vimdiff -y
    f = fetch
    gl = config --global -l
    l = log -1 HEAD --stat
    ll = log --oneline
    rv = remote -v
    se = log -S
    st = status -sb
    bclean = !git branch --merged main |\
             grep -Ev '^[*+]|^[[:space:]]*(master|main|dev)$' |\
             xargs -r git branch -d
    wtclean = !git worktree list |\
              awk '{print $1}' | tail -n +2 |\
              xargs -I {} git worktree remove {}

[branch]
    sort = -committerdate

[column]
    ui = auto

[commit]
    verbose = true

[core]
    autocrlf = input
    fsmonitor = true
    untrackedCache = true

[diff]
    algorithm = histogram
    colorMoved = zebra
    colorMovedWS = allow-indentation-change
    mnemonicPrefix = true

[fetch]
    prune = true

# Large File Storage
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f

[help]
    autocorrect = prompt

[init]
    defaultBranch = main

[merge]
    ff = only
    autoStash = true
    conflictStyle = zdiff3

[pull]
    rebase = true

[rebase]
    autoStash = true
    updateRefs = true
    missingCommitsCheck = error

[push]
    default = current
    autoSetupRemote = true
    followTags = true

[rerere]
    enabled = true
    autoUpdate = true

[submodule]
    recurse = true

[tag]
    sort = version:refname

