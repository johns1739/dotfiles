#!/usr/bin/env janet

(import ./utils/gh)
(use ./utils/helpers)

(def headers ["LABELS" "TITLE" "URL" "SUB-ISSUES" "BLOCKED COUNT"])

(defn issue-reference [issue]
  (let [url (issue :url)
        [repo-name number] (peg/match
                             '(* "https://github.com/"
                                 (thru "/")
                                 (<- (to "/"))
                                 "/issues/"
                                 (<- :d+))
                             url)]
    (string repo-name "#" number)))

(defn count-open-blockers [issue]
  (string (->> (get-in issue [:blockedBy :nodes])
               (filter |(= "OPEN" ($ :state)))
               (length))))

(defn issue-row [issue]
  [(string/join (map |($ :name) (issue :labels)) ", ")
   (issue :title)
   (issue :url)
   (string (get-in issue [:subIssuesSummary :total]))
   (count-open-blockers issue)])

(defn repo-issues [repo]
  (try
    (gh/assigned-issues repo)
    ([_error]
      (eprint "FAILED " repo)
      @[])))

(defn main
  [_script & repos]
  (->> repos
       (mapcat repo-issues)
       (sort-by |($ :createdAt))
       (map issue-row)
       (print-table headers)))
