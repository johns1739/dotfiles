#!/usr/bin/env janet

(import ./utils/git)

(defn sync-repo [repo-path]
  (print "\nSyncing " repo-path " ... ")

  (unless (git/is-git-dir? repo-path)
    (print "SKIP not a git directory: " repo-path)
    (break))

  (when (git/on-feature-branch? repo-path)
    (print "SKIP on feature branch: " (git/current-branch repo-path))
    (break))

  (git/fetch repo-path)
  (if (git/fast-forward-with-stash repo-path)
    (print "DONE")
    (print "FAILED")))

(defn sync-repos [repo-paths]
  (each repo-path repo-paths
    (sync-repo repo-path)))

(defn main
  [_script & repo-paths]
  (sync-repos repo-paths))
